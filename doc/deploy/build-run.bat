@echo off
setlocal EnableExtensions
rem Generated by CreateAndroidController.bat.

rem Build, install, and launch SenSketch on a connected Android device.
rem Optional: set ANDROID_SERIAL=<device_serial> when multiple devices are connected.

set "PROJECT_DIR=C:\app\AndroidStudioProjects\SenSketch"
set "PACKAGE_NAME=com.matsuge.gm.sensketch"
set "GRADLEW=%PROJECT_DIR%\gradlew.bat"
set "ANDROID_STUDIO_JBR=%ProgramFiles%\Android\Android Studio\jbr"

rem Prefer Android Studio's bundled JBR for the configured Gradle daemon JVM.
if exist "%ANDROID_STUDIO_JBR%\bin\java.exe" (
    set "JAVA_HOME=%ANDROID_STUDIO_JBR%"
    echo Using Android Studio Java runtime: %ANDROID_STUDIO_JBR%
)

if not exist "%GRADLEW%" (
    echo [ERROR] gradlew.bat was not found: %GRADLEW%
    pause
    exit /b 1
)
where adb >nul 2>nul
if errorlevel 1 (
    echo [ERROR] adb was not found in PATH.
    echo         Add Android SDK platform-tools to PATH, or run this from a terminal where adb is available.
    pause
    exit /b 1
)
echo.
echo === Connected devices ===
adb devices
if errorlevel 1 (
    echo [ERROR] Could not query connected devices.
    pause
    exit /b 1
)
echo.
echo === Build and install debug APK ===
pushd "%PROJECT_DIR%" >nul
call "%GRADLEW%" installDebug
set "RESULT=%ERRORLEVEL%"
popd >nul
if not "%RESULT%"=="0" (
    echo [ERROR] Gradle installDebug failed. Exit code: %RESULT%
    pause
    exit /b %RESULT%
)
echo.
echo === Launch app ===
adb shell monkey -p %PACKAGE_NAME% -c android.intent.category.LAUNCHER 1
if errorlevel 1 (
    echo [ERROR] Failed to launch %PACKAGE_NAME%.
    pause
    exit /b %errorlevel%
)
echo.
echo Done.
endlocal
